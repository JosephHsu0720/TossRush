<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="TossRushTestWindow.uss" />
    <ui:ScrollView mode="Vertical" class="tools-scroll">
    <ui:VisualElement class="test-tools">
        <ui:Label text="TossRush 測試工具" class="title" />
        <ui:Label text="固定關卡測試" class="section-title" />
        <ui:Label name="stageStatus" class="hint wrapped" />
        <ui:VisualElement name="stageActions" class="action">
            <ui:DropdownField name="stageChoice" label="測試關卡" />
            <ui:VisualElement class="stage-buttons">
                <ui:Button name="fixStage" text="固定此關卡" />
                <ui:Button name="normalRotation" text="恢復正常輪替" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="設定後按 Play 和 LET'S TOSS 開始；遊玩中切換會重新開始一般模式回合。" class="hint wrapped" />
        <ui:Label text="分數與解鎖紀錄" class="section-title" />
        <ui:VisualElement class="records">
            <ui:Label name="normalBest" />
            <ui:Label name="specialBest" />
            <ui:Label name="unlockState" class="wrapped" />
        </ui:VisualElement>
        <ui:Label text="請先停止 Play Mode，再清除或重設紀錄。" class="hint wrapped" />
        <ui:VisualElement name="actions">
            <ui:VisualElement class="action">
                <ui:Button name="clearScores" text="Clear High Score" />
                <ui:Label text="清除一般模式與特殊模式最高分，保留解鎖狀態。" class="wrapped" />
            </ui:VisualElement>
            <ui:VisualElement class="action">
                <ui:Button name="resetUnlock" text="Reset Special Mode Unlock" />
                <ui:Label text="重新鎖定特殊模式，並清除一般模式最高分；保留特殊模式最高分。" class="wrapped" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="lastAction" class="hint wrapped" />
    </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
